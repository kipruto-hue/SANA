# SANA — provider keys. Copy to `apps/web/.env` and fill in.
#
# `.env` is gitignored; this example file is the only one that is committed.
# Never put a real key in this file.
#
# ── Read this before adding a key ────────────────────────────────────────────
#
# Anything prefixed `VITE_` is **compiled into the browser bundle**. It is not
# hidden, not obfuscated, and anyone who can open the demo can read it. That is
# a consequence of the backend being cut for the demo, and it is fine for a
# controlled investor demo with throwaway keys — it is not fine for anything
# that ships. Use keys you can revoke, and revoke them afterwards.
#
# Anything without the `VITE_` prefix is read only by the tools in `tools/` at
# build time and never reaches the browser. Prefer this for any key you cannot
# cheaply rotate.
#
# With nothing set at all, SANA runs entirely on-device: the browser's own
# speech recognition and the on-device protocol matcher. That is a supported
# configuration, not a degraded one — the worst case is that SANA fails to
# match and says so, which is what the safety rails require anyway.

# ── Runtime: in the browser bundle ───────────────────────────────────────────

# The protocol selector — master prompt section 1.2.
# Only a protocol id and a confidence are ever read from the response
# (apps/web/src/lib/nlu.ts). OpenAI-compatible /chat/completions endpoint.
VITE_SANA_LLM_BASE_URL=
VITE_SANA_LLM_MODEL=
VITE_SANA_LLM_KEY=

# Speech to text — master prompt section 1.1. Language is detected here, from
# the audio, and never set by a person or guessed by the model.
VITE_SANA_STT_BASE_URL=https://api.openai.com/v1
VITE_SANA_STT_MODEL=whisper-1
VITE_SANA_STT_KEY=

# ── Build time: never in the browser bundle ──────────────────────────────────

# Fish Audio — SANA's voice, and the only one. Master prompt section 1.4.
#
# Used by tools/generate_audio.py to render the locked protocol steps and the
# eight locked system lines to files under apps/web/public/audio/, which the
# app then plays locally and offline. Deliberately not `VITE_` prefixed: the
# voice is generated ahead of time, so the browser never needs this key and
# must never carry it.
SANA_FISH_AUDIO_KEY=
SANA_FISH_AUDIO_VOICE_ID=
