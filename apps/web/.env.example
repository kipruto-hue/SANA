# SANA providers — copy to `apps/web/.env.local` and fill in.
#
# All six are optional. With none set, SANA runs entirely on-device: the
# browser's own speech recognition, and the on-device protocol matcher. That is
# a supported configuration, not a degraded one — the worst case is that SANA
# fails to match and says so, which is the behaviour the safety rails require
# anyway.
#
# Nothing here has a default. Decision 0003 applies to endpoints as much as to
# the emergency number: an absent provider shows as absent rather than falling
# back to a plausible guess.

# The protocol selector — master prompt section 1.2.
# Only a protocol id and a confidence are ever read from the response; see
# apps/web/src/lib/nlu.ts. OpenAI-compatible /chat/completions endpoint.
VITE_SANA_LLM_BASE_URL=
VITE_SANA_LLM_MODEL=
VITE_SANA_LLM_KEY=

# Speech to text — master prompt section 1.1. Language is detected here, from
# the audio, and never set by a person or guessed by the model.
VITE_SANA_STT_BASE_URL=
VITE_SANA_STT_MODEL=
VITE_SANA_STT_KEY=
